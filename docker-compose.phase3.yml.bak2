services:
  # -----------------------
  # Object store (S3 API)
  # -----------------------
  minio:
    image: minio/minio:latest
    container_name: minio
    command: server /data --console-address ":9001"
    env_file:
      - .env
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:-minioadmin}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:-change-this-password-in-production}
    ports:
      - "9000:9000"   # S3 API
      - "9001:9001"   # Console UI
    volumes:
      - minio_data:/data
    networks: [lake]
    healthcheck:
      test: ["CMD", "sh", "-c", "curl -fsS http://localhost:9000/minio/health/ready >/dev/null"]
      interval: 5s
      timeout: 3s
      retries: 30
    restart: unless-stopped

  # Create buckets on startup (idempotent)
  minio-init:
    image: minio/mc:latest
    container_name: minio-init
    depends_on:
      minio:
        condition: service_healthy
    networks: [lake]
    entrypoint: >
      /bin/sh -c "
      mc alias set local http://minio:9000 ${MINIO_ROOT_USER:-admin} ${MINIO_ROOT_PASSWORD:-password} &&
      mc mb -p local/iot-telemetry || true &&
      mc mb -p local/warehouse || true &&
      mc anonymous set download local/iot-telemetry || true &&
      echo '✅ MinIO buckets ensured: iot-telemetry, warehouse'
      "
    restart: "no"

  # -----------------------------------
  # Iceberg REST catalog (Option B)
  # -----------------------------------
  iceberg-rest:
    image: tabulario/iceberg-rest:latest
    container_name: iceberg-rest
    depends_on:
      minio:
        condition: service_healthy
    ports:
      - "8181:8181"
    environment:
      CATALOG_WAREHOUSE: s3://warehouse/
      CATALOG_IO__IMPL: org.apache.iceberg.aws.s3.S3FileIO
      CATALOG_S3_ENDPOINT: http://minio:9000
      CATALOG_S3_PATH__STYLE__ACCESS: "true"
      CATALOG_S3_ACCESS__KEY__ID: minioadmin
      CATALOG_S3_SECRET__ACCESS__KEY: password
      AWS_REGION: us-east-1
    volumes:
      - iceberg_catalog:/tmp
    networks: [lake]
    restart: unless-stopped

  # -----------------------
  # Trino query engine
  # -----------------------
  trino:
    image: trinodb/trino:latest
    container_name: trino
    depends_on:
      iceberg-rest:
        condition: service_started
    ports:
      - "8080:8080"
    volumes:
      - ./trino/etc:/etc/trino:ro
    networks: [lake]
    restart: unless-stopped

  # -----------------------
  # Superset metadata DB
  # -----------------------
  superset-db:
    image: postgres:16
    container_name: superset-db
    env_file:
      - .env
    environment:
      POSTGRES_DB: superset
      POSTGRES_USER: superset
      POSTGRES_PASSWORD: ${POSTGRES_SUPERSET_PASSWORD:-superset}
    ports:
      - "5432:5432"
    volumes:
      - superset_db:/var/lib/postgresql/data
    networks: [lake]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U superset -d superset"]
      interval: 5s
      timeout: 3s
      retries: 30
    restart: unless-stopped

  redis:
    image: redis:7
    container_name: superset-redis
    networks: [lake]
    restart: unless-stopped

  # -----------------------
  # Superset (BI)
  # -----------------------
  superset:
    build:
      context: .
      dockerfile: superset/Dockerfile
    container_name: superset
    depends_on:
      superset-db:
        condition: service_healthy
      redis:
        condition: service_started
      trino:
        condition: service_started
    ports:
      - "8088:8088"
    env_file:
      - .env
    environment:
      SUPERSET_SECRET_KEY: ${SUPERSET_SECRET_KEY:-change-me-in-real-life}
      SQLALCHEMY_DATABASE_URI: postgresql+psycopg2://superset:${POSTGRES_SUPERSET_PASSWORD:-superset}@superset-db:5432/superset
      REDIS_HOST: redis
      REDIS_PORT: 6379
    volumes:
      - superset_home:/app/superset_home
    networks: [lake]
    command: >
      /bin/sh -c "
      superset db upgrade &&
      superset init &&
      gunicorn -w 2 --timeout 120 -b 0.0.0.0:8088 'superset.app:create_app()'
      "
    restart: unless-stopped

  # -----------------------
  # Hive Metastore DB (Postgres)
  # -----------------------
  postgres-metastore:
    image: postgres:16
    container_name: postgres-metastore
    env_file:
      - .env
    environment:
      POSTGRES_DB: metastore_db
      POSTGRES_USER: hive
      POSTGRES_PASSWORD: ${POSTGRES_METASTORE_PASSWORD:-metastore-password-change-in-production}
    volumes:
      - metastore_pg_data:/var/lib/postgresql/data
    networks: [lake]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U hive -d metastore_db"]
      interval: 5s
      timeout: 3s
      retries: 30
    restart: unless-stopped

  # -----------------------
  # Hive Metastore (HMS) - fixed to use Postgres consistently
  # -----------------------
  hive-metastore:
    build:
      context: .
      dockerfile: Dockerfile.hive-metastore
    container_name: hive-metastore
    depends_on:
      postgres-metastore:
        condition: service_healthy
      minio:
        condition: service_healthy
    ports:
      - "9083:9083"
    networks: [lake]
    env_file:
      - .env
    environment:
      SERVICE_NAME: metastore

      # Keep DB_DRIVER aligned with the actual backend
      DB_DRIVER: postgres

      # IMPORTANT: Use Postgres driver + Postgres JDBC URL + correct hostname
      SERVICE_OPTS: >-
        -Djavax.jdo.option.ConnectionDriverName=org.postgresql.Driver
        -Djavax.jdo.option.ConnectionURL=jdbc:postgresql://postgres-metastore:5432/metastore_db
        -Djavax.jdo.option.ConnectionUserName=hive
        -Djavax.jdo.option.ConnectionPassword=${POSTGRES_METASTORE_PASSWORD:-metastore-password-change-in-production}

      # (Optional) ensure enough heap for schema init on smaller machines
      HADOOP_CLIENT_OPTS: "-Xmx1G"
      HADOOP_CONF_DIR: "/opt/hadoop/etc/hadoop"
      # HADOOP_CLASSPATH: "opt/hive/auxlib/*"


    # Add the Postgres JDBC driver to Hive's lib dir
    #volumes:
      #- ./jars/postgresql-jdbc.jar:/opt/hive/lib/postgresql-jdbc.jar:ro
      #- ./conf/core-site.xml:/opt/hadoop/etc/hadoop/core-site.xml:ro
      #- ./jars/hadoop-aws-3.3.6.jar:/opt/hive/lib/hadoop-aws-3.3.6.jar:ro
      #- ./jars/aws-java-sdk-bundle-1.12.367.jar:/opt/hive/lib/aws-java-sdk-bundle-1.12.367.jar:ro

    restart: unless-stopped

networks:
  lake:

volumes:
  minio_data:
  iceberg_catalog:
  superset_db:
  superset_home:
  metastore_pg_data:
