# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-password-in-production

# Trino Configuration
TRINO_CATALOG_FILE=/etc/trino/catalog/iceberg.properties

# Superset Configuration
