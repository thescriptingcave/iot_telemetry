# MinIO Configuration (generate with: openssl rand -base64 32)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Trino Configuration
TRINO_CATALOG_FILE=/etc/trino/catalog/iceberg.properties

# Superset Configuration (generate with: openssl rand -base64 32)
SUPERSET_SECRET_KEY=change-me-in-real-life-use-openssl-rand-base64-32
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://superset:superset@superset-db:5432/superset

# Database Credentials (generate with: openssl rand -base64 32)
POSTGRES_METASTORE_PASSWORD=metastore-password-change-in-production
POSTGRES_SUPERSET_PASSWORD=superset-password-change-in-production
